# Copy this file to .env and fill in the two values from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# EXPO_PUBLIC_ is not a mistake. Expo only exposes variables with that prefix
# to the app, and both of these are meant to be public: the anon key is what
# every client uses, and row level security in the database is what actually
# decides who can read what. Never put the service_role key here.
#
# Restart the dev server after editing .env; Expo reads it at startup.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
